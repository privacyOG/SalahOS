{
  "name": "salahos",
  "version": "0.1.0",
  "private": true,
  "author": "privacyOG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:web-build": "node scripts/verify-web-build.mjs",
    "verify:service-worker-cache-boundary": "node scripts/verify-service-worker-cache-boundary.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:capacitor-config": "node scripts/verify-capacitor-config.mjs",
    "verify:native-storage": "node scripts/verify-native-storage-boundary.mjs",
    "verify:ios-safe-area": "node scripts/verify-ios-safe-area.mjs",
    "verify:ios-visual-wiring": "node scripts/verify-ios-visual-wiring.mjs",
    "verify:native-dependencies": "node scripts/verify-native-dependency-surface.mjs",
    "verify:native-permissions": "node scripts/verify-native-permissions.mjs",
    "verify:android-merged-permissions": "node scripts/verify-android-merged-permissions.mjs",
    "verify:android-emulator-wiring": "node scripts/verify-android-emulator-wiring.mjs",
    "verify:remote-api-boundary": "node scripts/verify-remote-api-boundary.mjs",
    "verify:local-adhan-audio": "node scripts/verify-local-adhan-audio.mjs",
    "verify:notification-capabilities": "node scripts/verify-notification-capabilities.mjs",
    "verify:visual-regression-wiring": "node scripts/verify-visual-regression.mjs",
    "verify:visual-regression": "node scripts/visual-regression.mjs",
    "verify:accessibility-contract": "node scripts/verify-accessibility-contract.mjs",
    "verify:accessibility-browser": "node scripts/accessibility-browser-regression.mjs",
    "verify:authorship": "node scripts/verify-authorship.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node scripts/check-doc-links.mjs",
    "security:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "security:licenses": "node scripts/check-dependency-licenses.mjs",
    "check": "npm run security:sensitive-files && npm run security:audit && npm run security:licenses && npm run docs:links && npm run verify:authorship && npm run verify:service-worker-cache-boundary && npm run verify:release-version && npm run verify:capacitor-config && npm run verify:native-storage && npm run verify:native-dependencies && npm run verify:ios-safe-area && npm run verify:ios-visual-wiring && npm run verify:native-permissions && npm run verify:android-emulator-wiring && npm run verify:remote-api-boundary && npm run verify:local-adhan-audio && npm run verify:notification-capabilities && npm run verify:visual-regression-wiring && npm run verify:accessibility-contract && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:web-build",
    "android:sync": "npm run build && cap sync android && npm run verify:capacitor-config && npm run verify:native-dependencies",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug && cd .. && npm run verify:android-reboot && npm run verify:android-merged-permissions",
    "android:release-check": "npm run android:sync && cd android && ./gradlew assembleRelease && cd .. && npm run verify:android-merged-permissions",
    "verify:android-reboot": "node scripts/verify-android-notification-reboot.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/ios": "8.4.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/preferences": "8.0.1",
    "@photostructure/tz-lookup": "11.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
