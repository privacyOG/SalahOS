{
  "name": "salahos",
  "version": "1.1.0",
  "private": true,
  "author": "privacyOG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:web-build": "node scripts/verify-web-build.mjs",
    "visual:check": "node scripts/visual-regression.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write src/ui/QiblaCompassPanel.tsx && git diff -- src/ui/QiblaCompassPanel.tsx",
    "docs:links": "node scripts/check-doc-links.mjs",
    "security:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "security:native-permissions": "node scripts/check-native-permissions.mjs",
    "security:remote-network": "node scripts/check-remote-network-policy.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "security:licenses": "node scripts/check-dependency-licenses.mjs",
    "check": "npm run security:sensitive-files && npm run security:native-permissions && npm run security:remote-network && npm run security:audit && npm run security:licenses && npm run docs:links && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:web-build",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug && cd .. && npm run verify:android-reboot",
    "android:release-check": "node scripts/build-android-release.mjs",
    "android:release-unsigned-check": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "verify:android-reboot": "node scripts/verify-android-notification-reboot.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/ios": "8.4.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/preferences": "8.0.1",
    "@photostructure/tz-lookup": "11.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
