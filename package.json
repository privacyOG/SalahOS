{
  "name": "salahos",
  "version": "0.1.0",
  "private": true,
  "author": "privacyOG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:web-build": "node scripts/verify-web-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run security:sensitive-files && npm run security:audit && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:web-build"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
